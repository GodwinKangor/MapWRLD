# Optional: Street View photos in the building panel (server-side only)
GOOGLE_MAPPLATFORM_APIKEY=
# Optional: read buildings from Supabase instead of the bundled data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: Google Photorealistic 3D Tiles as "Real-world surroundings" around the campus.
# Browser-visible, so restrict it by HTTP referrer and to the Map Tiles API. If unset, the
# Cesium ion token is used instead (ion hosts Google's tiles as asset 2275207).
NEXT_PUBLIC_GOOGLE_MAPS_3D_KEY=
NEXT_PUBLIC_CESIUM_ION_TOKEN=
