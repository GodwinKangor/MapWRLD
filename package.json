{
  "name": "dartmouth-energy-twin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "model:figure": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-figure.py",
    "model:figure:open": "open public/models/figure/figure.blend",
    "model:dartmouth:preview": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-preview-file.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend",
    "model:dartmouth:fetch-names": "node scripts/fetch-dartmouth-osm-names.mjs",
    "model:dartmouth:check-geojsons": "node scripts/check-dartmouth-geojsons.mjs",
    "model:dartmouth:apply-geojson-names": "node scripts/apply-dartmouth-geojson-names.mjs",
    "model:dartmouth:apply-names": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-apply-osm-names.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend public/models/dartmouth-energy-twin/reports/osm-campus-names.json",
    "model:dartmouth:add-controllers": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-add-mesh-controllers.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend",
    "model:dartmouth:add-detail-controllers": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-add-detail-controllers.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend",
    "model:dartmouth:apply-details": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-apply-building-details.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend",
    "model:dartmouth:build-baker-reference": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-build-baker-reference-details.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend",
    "model:dartmouth:build-baker-integrated": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-build-baker-integrated-facades.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend",
    "model:dartmouth:build-dartmouth-hall-integrated": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-build-dartmouth-hall-integrated.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend",
    "model:dartmouth:rebuild-baker": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-rebuild-baker-massing.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend",
    "model:dartmouth:restore-baker": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-restore-baker-backup.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend",
    "model:dartmouth:clean-geometry": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-clean-geometry.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend",
    "model:dartmouth:audit-laws": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-audit-model-laws.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend",
    "model:dartmouth:render-baker-preview": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-render-baker-preview.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend",
    "model:dartmouth:render-building-preview": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-render-building-preview.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend",
    "model:dartmouth:baker:pipeline": "npm run model:dartmouth:build-baker-integrated && npm run model:dartmouth:audit-laws -- baker-library --strict && npm run model:dartmouth:export-parts -- --only baker-library --force-export && npm run model:dartmouth:render-baker-preview",
    "model:dartmouth:dartmouth-hall:pipeline": "npm run model:dartmouth:build-dartmouth-hall-integrated && npm run model:dartmouth:audit-laws -- dartmouth-hall --strict && npm run model:dartmouth:export-parts -- --only dartmouth-hall --force-export && npm run model:dartmouth:render-building-preview -- dartmouth-hall",
    "model:dartmouth:export-parts": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/blender-export-dartmouth-parts.py -- public/models/dartmouth-energy-twin/dartmouth-energy-twin.blend",
    "model:dartmouth:references": "node scripts/generate-building-references.mjs",
    "model:dartmouth:reference-candidates": "node scripts/generate-wall-reference-candidates.mjs",
    "reference:images": "node scripts/generate-reference-images.mjs",
    "reference:images:clear": "node scripts/clear-reference-images.mjs --confirm",
    "reference:facades": "node scripts/generate-facade-references.mjs",
    "reference:facades:test": "node scripts/generate-facade-references.mjs --limit 5",
    "reference:facades:plan": "node scripts/generate-facade-references.mjs --plan-only",
    "reference:facades:plan:test": "node scripts/generate-facade-references.mjs --limit 3 --plan-only",
    "reference:facades:multi": "node scripts/generate-facade-references.mjs --shots-per-face 2",
    "reference:facades:guides": "node scripts/generate-facade-guides.mjs",
    "reference:wikimedia": "node scripts/generate-wikimedia-candidates.mjs",
    "reference:wikimedia:test": "node scripts/generate-wikimedia-candidates.mjs --limit 10",
    "reference:wikimedia:dartmouth-hall": "node scripts/generate-wikimedia-candidates.mjs --only \"Dartmouth Hall\"",
    "reference:open": "node scripts/generate-open-reference-candidates.mjs",
    "reference:open:test": "node scripts/generate-open-reference-candidates.mjs --limit 10",
    "reference:open:dartmouth-hall": "node scripts/generate-open-reference-candidates.mjs --only \"Dartmouth Hall\"",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "typescript": "^5.7.2"
  }
}
